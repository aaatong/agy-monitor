{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "AGY Monitor",
  "description": "Live monitor for current session context window, aggregated main+subagent token usage, and prompt cache hit rate.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "AGY Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "AGY Monitor"
      }
    ]
  }
}
